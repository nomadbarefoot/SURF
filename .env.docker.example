# Docker runtime configuration for SURF.
# Copy this file to .env.docker, then run:
#   docker compose --env-file .env.docker up --build -d
# Everything below is optional; the defaults give keyless search plus local
# embeddings.

# --- Optional services ----------------------------------------------------
# Comma-separated Compose profiles to start alongside SURF:
#   embeddings  local embedding server for semantic ranking (recommended)
#   searxng     self-hosted metasearch fallback (also set SEARXNG_SECRET)
COMPOSE_PROFILES=embeddings

# --- Search -----------------------------------------------------------------
# Without a key SURF uses Exa's free, rate-limited hosted endpoint.
# A key (https://exa.ai) uses the Exa API directly with higher limits.
SURF_EXA_API_KEY=
# Required only with the searxng profile: `openssl rand -hex 32`.
SEARXNG_SECRET=

# --- Semantic ranking (recommended) ---------------------------------------
# Without an embeddings endpoint, search ranks by keyword (BM25) only.
# The two lines below match the bundled `embeddings` profile. To bring your
# own, point at any OpenAI-compatible /v1/embeddings server (LiteLLM, OpenAI,
# vLLM) and set its model and API key.
SURF_EMBEDDING_BASE_URL=http://embeddings:8080/v1
SURF_EMBEDDING_MODEL=nomic-embed-text
SURF_EMBEDDING_API_KEY=
# 768 for nomic-embed-text. Set 0 if your server rejects the `dimensions` field.
SURF_EMBEDDING_DIMENSIONS=768
# Bundled server only: GGUF model to serve (Hugging Face repo[:quant]).
# SURF_EMBEDDING_HF_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF:Q8_0

# --- Specialist profiles (HTTP) -------------------------------------------
# Leave a key empty to disable that profile. Use distinct values of at least
# 32 characters (`openssl rand -hex 24`).
SURF_BROWSE_KEY=
SURF_UI_KEY=
SURF_FINANCE_KEY=
SURF_OPS_KEY=
# Comma-separated extra Host headers accepted by Streamable HTTP MCP.
# Compose sets its internal service name automatically.
# SURF_MCP_ALLOWED_HOSTS=surf:17777

SURF_LOG_LEVEL=INFO
